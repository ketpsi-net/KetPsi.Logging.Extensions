<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="../../version.props"></Import>

	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Description>A zero-allocation OpenTelemetry (OTLP) log exporter for .NET. Bypasses the official SDK to serialize logs directly into raw Protobuf bytes via a lock-free batcher, delivering 22x faster execution and zero GC pressure for extreme-throughput microservices.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\KetPsi.Extensions.Logging.Abstractions\KetPsi.Extensions.Logging.Abstractions.csproj" />
	</ItemGroup>


	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="9.0.20" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.20" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
	</ItemGroup>


	<ItemGroup>
		<InternalsVisibleTo Include="KetPsi.Extensions.Logging.Tests"/>
		<InternalsVisibleTo Include="KetPsi.Extensions.Logging.OpenTelemetry.Benchmarks"/>
	</ItemGroup>

</Project>
